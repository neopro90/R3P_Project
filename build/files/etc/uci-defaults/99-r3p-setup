#!/bin/sh
# ============================================================
# R3P UCI defaults — runs once on first boot
# Sets up base network config for Xiaomi Mi Router 3 Pro
# ============================================================

# Hostname & Timezone (OpenWrt musl TZ string ICT-7 = Asia/Ho_Chi_Minh UTC+7)
uci set system.@system[0].hostname='R3P-Router'
uci set system.@system[0].timezone='ICT-7'
uci set system.@system[0].zonename='Asia/Ho_Chi_Minh'
uci commit system

# Set default LAN IP and explicit /24 netmask (critical for routing)
uci set network.lan.ipaddr='192.168.2.1'
uci set network.lan.netmask='255.255.255.0'
uci commit network

# Default 2.4GHz Wi-Fi AP & factory-boot SSH onboarding (initial image only).
# IMPORTANT: Change the root password, Wi-Fi PSK, and generate an API token in
# Access/System settings immediately after first boot (see SECURITY_MODEL.md).
# Initial SSID: r3pminisever, Initial PSK: admin1234, Initial Host: 192.168.2.1
[ -s /etc/config/wireless ] || wifi config
uci set wireless.radio0.disabled='0'
uci -q set wireless.radio0.country='VN'
uci -q delete wireless.default_radio0
uci set wireless.default_radio0=wifi-iface
uci set wireless.default_radio0.device='radio0'
uci set wireless.default_radio0.network='lan'
uci set wireless.default_radio0.mode='ap'
uci set wireless.default_radio0.ssid='r3pminisever'
uci set wireless.default_radio0.encryption='psk2'
uci set wireless.default_radio0.key='admin1234'
uci set wireless.default_radio0.disabled='0'
uci commit wireless

# Set root password to 'root'
echo -e "root\nroot" | passwd root

# Dropbear SSH: bind dual-stack to allow access over both IPv4 and IPv6
uci set dropbear.@dropbear[0].Port='22'
uci set dropbear.@dropbear[0].PasswordAuth='on'
uci set dropbear.@dropbear[0].RootPasswordAuth='on'
uci -q delete dropbear.@dropbear[0].Interface
uci commit dropbear

# Ensure NAS base directories and compatibility symlinks (/mnt/sda <-> /mnt/sda1, Share <-> share)
mkdir -p /mnt/sda1/share /mnt/sda1/downloads /overlay/share /overlay/downloads
# World-writable so SMB clients can write regardless of auth mode or FS mount options
chmod 777 /mnt/sda1/share /mnt/sda1/downloads /overlay/share /overlay/downloads 2>/dev/null || true
ln -sfn /mnt/sda1 /mnt/sda 2>/dev/null
ln -sfn /mnt/sda1/share /mnt/sda1/Share 2>/dev/null

# Clean up default OpenWrt ksmbd testshare/share and configure canonical R3P shares
if [ -f /etc/config/ksmbd ]; then
    while uci -q delete ksmbd.@share[0]; do :; done
    uci set ksmbd.@globals[0].workgroup='WORKGROUP'
    uci set ksmbd.@globals[0].description='R3P Mini Server NAS'
    uci set ksmbd.@globals[0].interface='lan'
    uci set ksmbd.@globals[0].allow_guest_ipc='1'

    uci add ksmbd share >/dev/null
    uci set ksmbd.@share[-1].name='USB_Storage'
    uci set ksmbd.@share[-1].path='/mnt/sda1/share'
    uci set ksmbd.@share[-1].read_only='no'
    uci set ksmbd.@share[-1].guest_ok='yes'
    uci set ksmbd.@share[-1].create_mask='0666'
    uci set ksmbd.@share[-1].dir_mask='0777'
    uci set ksmbd.@share[-1].force_root='1'
    uci set ksmbd.@share[-1].browseable='yes'

    uci add ksmbd share >/dev/null
    uci set ksmbd.@share[-1].name='USB_Downloads'
    uci set ksmbd.@share[-1].path='/mnt/sda1/downloads'
    uci set ksmbd.@share[-1].read_only='no'
    uci set ksmbd.@share[-1].guest_ok='yes'
    uci set ksmbd.@share[-1].create_mask='0666'
    uci set ksmbd.@share[-1].dir_mask='0777'
    uci set ksmbd.@share[-1].force_root='1'
    uci set ksmbd.@share[-1].browseable='yes'

    uci add ksmbd share >/dev/null
    uci set ksmbd.@share[-1].name='NAND_Share'
    uci set ksmbd.@share[-1].path='/overlay/share'
    uci set ksmbd.@share[-1].read_only='no'
    uci set ksmbd.@share[-1].guest_ok='yes'
    uci set ksmbd.@share[-1].create_mask='0666'
    uci set ksmbd.@share[-1].dir_mask='0777'
    uci set ksmbd.@share[-1].force_root='1'
    uci set ksmbd.@share[-1].browseable='yes'

    uci commit ksmbd
fi

# Provision ksmbd SMB users (ksmbd has its own user DB, separate from Linux shadow)
# Add root user with password 'root' so Windows clients can authenticate
if command -v ksmbd.useradd >/dev/null 2>&1; then
    ksmbd.useradd -a root -p root 2>/dev/null || ksmbd.useradd root -p root 2>/dev/null || true
fi
# Also set up samba4 passdb for compatibility (ignored if smbpasswd not installed)
(echo root; echo root) | smbpasswd -a -s root 2>/dev/null || true

[ -x /etc/init.d/ksmbd ] && {
    /etc/init.d/ksmbd enable
    /etc/init.d/ksmbd restart 2>/dev/null || true
}

# Ensure /etc/r3p configs and AI blueprints are preserved during sysupgrade & backups
grep -q '^/etc/r3p' /etc/sysupgrade.conf 2>/dev/null || echo '/etc/r3p' >> /etc/sysupgrade.conf

# Start the API daemon
/etc/init.d/r3p-api enable
/etc/init.d/r3p-api start

logger -t r3p-setup "R3P first-boot setup complete with 192.168.2.1/24"
