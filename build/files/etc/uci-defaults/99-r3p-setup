#!/bin/sh
# ============================================================
# R3P UCI defaults — runs once on first boot
# Sets up base network config for Xiaomi Mi Router 3 Pro
# ============================================================

# Hostname & Timezone
uci set system.@system[0].hostname='R3P-Router'
uci set system.@system[0].timezone='Asia/Ho_Chi_Minh'
uci set system.@system[0].zonename='Asia/Ho Chi Minh'
uci commit system

# Set default LAN IP and explicit /24 netmask (critical for routing)
uci set network.lan.ipaddr='192.168.2.1'
uci set network.lan.netmask='255.255.255.0'
uci commit network

# Default 2.4GHz Wi-Fi AP for initial flash onboarding
# SSID: r3pminisever, Password: admin1234 (WPA2-PSK requires 8+ chars), Host: 192.168.2.1
[ -s /etc/config/wireless ] || wifi config
uci set wireless.radio0.disabled='0'
uci -q set wireless.radio0.country='VN'
uci -q delete wireless.default_radio0
uci set wireless.default_radio0=wifi-iface
uci set wireless.default_radio0.device='radio0'
uci set wireless.default_radio0.network='lan'
uci set wireless.default_radio0.mode='ap'
uci set wireless.default_radio0.ssid='r3pminisever'
uci set wireless.default_radio0.encryption='psk2'
uci set wireless.default_radio0.key='admin1234'
uci set wireless.default_radio0.disabled='0'
uci commit wireless

# Set root password to 'root'
echo -e "root\nroot" | passwd root

# Dropbear SSH: bind dual-stack to allow access over both IPv4 and IPv6
uci set dropbear.@dropbear[0].Port='22'
uci set dropbear.@dropbear[0].PasswordAuth='on'
uci set dropbear.@dropbear[0].RootPasswordAuth='on'
uci -q delete dropbear.@dropbear[0].Interface
uci commit dropbear

# Ensure /etc/r3p configs and AI blueprints are preserved during sysupgrade & backups
grep -q '^/etc/r3p' /etc/sysupgrade.conf 2>/dev/null || echo '/etc/r3p' >> /etc/sysupgrade.conf

# Start the API daemon
/etc/init.d/r3p-api enable
/etc/init.d/r3p-api start

logger -t r3p-setup "R3P first-boot setup complete with 192.168.2.1/24"
